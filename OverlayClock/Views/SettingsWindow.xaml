<Window x:Class="OverlayClock.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OverlayClock — Settings"
        Width="480" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        Foreground="#111111"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>

        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8822A"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#AAAAAA"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#AAAAAA"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

    </Window.Resources>

    <DockPanel Margin="20">

        <!-- Title -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="OverlayClock" FontSize="18" FontWeight="Bold"
                       Foreground="#C8822A"/>
            <TextBlock Text="Settings" FontSize="12" Foreground="#666666"/>
            <Separator Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnCancel" Content="Cancel"
                    Style="{StaticResource GhostButton}"
                    Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnOK" Content="Apply &amp; Close"
                    Style="{StaticResource ActionButton}"
                    Click="BtnOK_Click"/>
        </StackPanel>

        <!-- Main scroll area -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" DockPanel.Dock="Top">
            <StackPanel>

                <!-- CLOCK FACE IMAGE -->
                <TextBlock Text="CLOCK FACE" Style="{StaticResource SectionHead}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtImagePath" Grid.Column="0"
                             Margin="0,0,6,0" IsReadOnly="True"
                             Text="(using built-in default face)"/>
                    <Button x:Name="BtnBrowse" Grid.Column="1" Content="Browse…"
                            Style="{StaticResource GhostButton}"
                            Padding="10,4" Click="BtnBrowse_Click"/>
                </Grid>
                <Button x:Name="BtnClearImage" Content="Reset to default face"
                        Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,3"
                        Click="BtnClearImage_Click"/>

                <!-- TIME SYSTEM -->
                <TextBlock Text="TIME SYSTEM" Style="{StaticResource SectionHead}"/>
                <ComboBox x:Name="CmbMode"/>
                <TextBlock x:Name="TxtModeDesc" Foreground="#555555" FontSize="11"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>

                <!-- CUSTOM MODE -->
                <Expander x:Name="ExpCustom" Header="Custom time system…"
                          Margin="0,6,0,0" Expanded="ExpCustom_Expanded">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Hours per day"           Style="{StaticResource RowLabel}" Grid.Row="0" Grid.Column="0"/>
                        <TextBox x:Name="TxtCustomHours"          Grid.Row="0" Grid.Column="1" Margin="0,2"/>
                        <TextBlock Text="Minutes per hour"        Style="{StaticResource RowLabel}" Grid.Row="1" Grid.Column="0"/>
                        <TextBox x:Name="TxtCustomMinutes"        Grid.Row="1" Grid.Column="1" Margin="0,2"/>
                        <TextBlock Text="Seconds per minute"      Style="{StaticResource RowLabel}" Grid.Row="2" Grid.Column="0"/>
                        <TextBox x:Name="TxtCustomSeconds"        Grid.Row="2" Grid.Column="1" Margin="0,2"/>
                        <TextBlock Text="Major ticks"             Style="{StaticResource RowLabel}" Grid.Row="3" Grid.Column="0"/>
                        <TextBox x:Name="TxtCustomMajorTicks"     Grid.Row="3" Grid.Column="1" Margin="0,2"/>
                        <TextBlock Text="Minor ticks per segment" Style="{StaticResource RowLabel}" Grid.Row="4" Grid.Column="0"/>
                        <TextBox x:Name="TxtCustomMinorTicks"     Grid.Row="4" Grid.Column="1" Margin="0,2"/>
                        <TextBlock Text="Rotations per day"       Style="{StaticResource RowLabel}" Grid.Row="5" Grid.Column="0"/>
                        <TextBox x:Name="TxtCustomRotations"      Grid.Row="5" Grid.Column="1" Margin="0,2"/>
                    </Grid>
                </Expander>

                <!-- TIME ZONE -->
                <TextBlock Text="TIME ZONE" Style="{StaticResource SectionHead}"/>
                <ComboBox x:Name="CmbTimeZone"/>

                <!-- APPEARANCE -->
                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHead}"/>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Scale" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="SldScale" Grid.Column="1"
                            Minimum="0.1" Maximum="2.0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            ValueChanged="SldScale_ValueChanged"/>
                    <TextBlock x:Name="TxtScaleVal" Grid.Column="2"
                               Foreground="#555555" FontSize="11"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Opacity" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="SldOpacity" Grid.Column="1"
                            Minimum="0.1" Maximum="1.0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            ValueChanged="SldOpacity_ValueChanged"/>
                    <TextBlock x:Name="TxtOpacityVal" Grid.Column="2"
                               Foreground="#555555" FontSize="11"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </Grid>

                <CheckBox x:Name="ChkAlwaysOnTop" Content="Always on top"        Margin="0,4"/>
                <CheckBox x:Name="ChkShowSeconds" Content="Show seconds hand"     Margin="0,2"/>
                <CheckBox x:Name="ChkShowDate"    Content="Show date on clock face" Margin="0,2"/>
                <CheckBox x:Name="ChkShowMajor"   Content="Show major tick marks" Margin="0,2"/>
                <CheckBox x:Name="ChkShowMinor"   Content="Show minor tick marks" Margin="0,2"/>

                <!-- COLOURS -->
                <TextBlock Text="COLOURS" Style="{StaticResource SectionHead}"/>
                <TextBlock Text="Enter colours as #RRGGBB hex values."
                           Foreground="#777777" FontSize="10" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Hour hand"   Style="{StaticResource RowLabel}" Grid.Row="0" Grid.Column="0"/>
                    <TextBox x:Name="TxtHourColor"      Grid.Row="0" Grid.Column="1" Margin="0,2"/>
                    <TextBlock Text="Minute hand" Style="{StaticResource RowLabel}" Grid.Row="1" Grid.Column="0"/>
                    <TextBox x:Name="TxtMinuteColor"    Grid.Row="1" Grid.Column="1" Margin="0,2"/>
                    <TextBlock Text="Second hand" Style="{StaticResource RowLabel}" Grid.Row="2" Grid.Column="0"/>
                    <TextBox x:Name="TxtSecondColor"    Grid.Row="2" Grid.Column="1" Margin="0,2"/>
                    <TextBlock Text="Major ticks" Style="{StaticResource RowLabel}" Grid.Row="3" Grid.Column="0"/>
                    <TextBox x:Name="TxtMajorTickColor" Grid.Row="3" Grid.Column="1" Margin="0,2"/>
                    <TextBlock Text="Minor ticks" Style="{StaticResource RowLabel}" Grid.Row="4" Grid.Column="0"/>
                    <TextBox x:Name="TxtMinorTickColor" Grid.Row="4" Grid.Column="1" Margin="0,2"/>
                    <TextBlock Text="Date"        Style="{StaticResource RowLabel}" Grid.Row="5" Grid.Column="0"/>
                    <TextBox x:Name="TxtDateColor"      Grid.Row="5" Grid.Column="1" Margin="0,2"/>
                </Grid>

                <!-- HAND THICKNESS -->
                <TextBlock Text="HAND THICKNESS" Style="{StaticResource SectionHead}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Hour"   Style="{StaticResource RowLabel}" Grid.Row="0"/>
                    <Slider x:Name="SldHourThick"   Grid.Row="0" Grid.Column="1"
                            Minimum="0.3" Maximum="3.0" TickFrequency="0.1"
                            ValueChanged="SldThick_ValueChanged"/>
                    <TextBlock x:Name="TxtHourThick" Grid.Row="0" Grid.Column="2"
                               Foreground="#555555" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <TextBlock Text="Minute" Style="{StaticResource RowLabel}" Grid.Row="1"/>
                    <Slider x:Name="SldMinuteThick" Grid.Row="1" Grid.Column="1"
                            Minimum="0.3" Maximum="3.0" TickFrequency="0.1"
                            ValueChanged="SldThick_ValueChanged"/>
                    <TextBlock x:Name="TxtMinuteThick" Grid.Row="1" Grid.Column="2"
                               Foreground="#555555" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <TextBlock Text="Second" Style="{StaticResource RowLabel}" Grid.Row="2"/>
                    <Slider x:Name="SldSecondThick" Grid.Row="2" Grid.Column="1"
                            Minimum="0.3" Maximum="3.0" TickFrequency="0.1"
                            ValueChanged="SldThick_ValueChanged"/>
                    <TextBlock x:Name="TxtSecondThick" Grid.Row="2" Grid.Column="2"
                               Foreground="#555555" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </Grid>

                <!-- ABOUT -->
                <TextBlock Text="ABOUT" Style="{StaticResource SectionHead}"/>
                <TextBlock x:Name="TxtVersion" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtRuntime" Foreground="#555555" FontSize="11" Margin="0,2,0,6"/>
                <TextBlock Text="Created by Per Hejndorf" Foreground="#333333"/>
                <TextBlock Text="Built with WPF on .NET 10, with help from Claude Code"
                           Foreground="#555555" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>

                <Separator Margin="0,16,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
