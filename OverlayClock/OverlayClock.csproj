<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>OverlayClock</RootNamespace>
    <AssemblyName>OverlayClock</AssemblyName>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU</Platforms>
    <ApplicationIcon>Assets\clock.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Authors>Per Hejndorf</Authors>
    <!-- Velopack's Program.Main replaces the generated WPF entry point -->
    <StartupObject>OverlayClock.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\clockface.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\clockface_default.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
